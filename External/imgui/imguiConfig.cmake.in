@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find OpenGL and GLFW dependencies
find_dependency(OpenGL REQUIRED)
find_dependency(glfw3 REQUIRED)

# Include targets file
include("${CMAKE_CURRENT_LIST_DIR}/imgui_targets.cmake")

# Set ImGui variables
set(IMGUI_FOUND TRUE)
set(IMGUI_INCLUDE_DIRS "@PACKAGE_INSTALL_DIR@/include")
set(IMGUI_LIBRARIES imgui::imgui)

check_required_components(imgui)