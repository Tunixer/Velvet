@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find OpenGL dependency
find_dependency(OpenGL)

# Include targets file
include("${CMAKE_CURRENT_LIST_DIR}/glad_targets.cmake")

# Set GLAD variables
set(GLAD_FOUND TRUE)
set(GLAD_INCLUDE_DIRS "@PACKAGE_INSTALL_DIR@/include")
set(GLAD_LIBRARIES glad::glad)

check_required_components(glad)